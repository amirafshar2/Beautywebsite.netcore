@{
    var P = (PanelContext)ViewData["Panel"]!;
    ViewData["Title"] = P["nav.account"];
    ViewData["Nav"] = "account";
    var errors = ViewData["Errors"] as Dictionary<string, string> ?? [];
}
@if (P.User.MustChangePassword)
{
    <p class="hint-note">@P["account.mustChange"]</p>
}
<partial name="_PageIntro" model='("intro.account", (string?)null)' />
<div class="card">
    <h2>@P["account.changePassword"]</h2>
    <p class="soft">@P["account.signedInAs"]: <b class="ltr">@P.User.UserName</b></p>
    <form asp-antiforgery="true" class="form" method="post" data-dirty>
        @foreach (var (name, key, auto) in new[] { ("currentPassword", "account.currentPassword", "current-password"), ("newPassword", "account.newPassword", "new-password"), ("confirmPassword", "account.confirmPassword", "new-password") })
        {
            <div class="field @(errors.ContainsKey(name) ? "has-error" : "")">
                <label for="@name">@P[key]</label>
                <input id="@name" name="@name" type="password" autocomplete="@auto" required dir="ltr" />
                @if (name == "newPassword") { <p class="help">@P["account.passwordRules"]</p> }
                @if (errors.TryGetValue(name, out var e)) { <p class="err">@e</p> }
            </div>
        }
        <div><button class="btn btn-primary" type="submit">@P["common.save"]</button></div>
    </form>
</div>
