@model IReadOnlyList<SiteText>
@{
    var P = (PanelContext)ViewData["Panel"]!;
    ViewData["Title"] = P["nav.about"];
    ViewData["Nav"] = "about";
    ViewData["TextsGroup"] = "about";
    var expertise = (IReadOnlyList<ListItem>)ViewData["Expertise"]!;
    var certificates = (IReadOnlyList<ListItem>)ViewData["Certificates"]!;
}
<partial name="_PageIntro" model='("intro.about", $"/{P.DefaultLanguage.Code}/about")' />
<form asp-antiforgery="true" method="post" data-dirty>
    <div class="grid-side">
        <div class="card form">
            <h2>@P["about.texts"]</h2>
            <partial name="_TextsEditor" model="Model" view-data="ViewData" />
        </div>
        <div>
            <div class="card"><partial name="_ImageField" model='new ImageField("aboutImageId", P.Settings.AboutImageId, ViewData["Image"] as string, "about.photo", "about.photoHelp", 0.8)' /></div>
            <partial name="_WhereOnSite" model='new WhereOnSite("about")' />
        </div>
    </div>
    <div class="card save-bar"><button class="btn btn-primary btn-lg" type="submit">@P["common.save"]</button></div>
</form>

<div class="card">
    <h2>@P["about.expertise"]</h2>
    <p class="help">@P["about.expertiseHelp"]</p>
    <partial name="_ListEditor" model='(ListKeys.Expertise, expertise, "about", false)' />
</div>
<div class="card">
    <h2>@P["about.certificates"]</h2>
    <p class="help">@P["about.certificatesHelp"]</p>
    <partial name="_ListEditor" model='(ListKeys.Certificates, certificates, "about", true)' />
</div>
