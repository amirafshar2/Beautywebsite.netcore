@model IReadOnlyList<ChatThread>
@{
    var P = (PanelContext)ViewData["Panel"]!;
    ViewData["Title"] = P["nav.chats"];
    ViewData["Nav"] = "chats";
}
<partial name="_PageIntro" model='("intro.chats", (string?)null)' />
@if (!P.Settings.ChatAvailable)
{
    <p class="hint-note">@P["chat.notActive"] <a href="@P.Url("settings#email")">@P["nav.settings"]</a></p>
}
@if (Model.Count == 0)
{
    <div class="card empty">@P["chat.empty"]</div>
}
else
{
    <div class="list">
        @foreach (var t in Model)
        {
            <a class="item" href="@P.Url($"chats/conversation/{t.Visitor.Id}")">
                <div class="body">
                    <span class="title">@t.Visitor.Name @if (t.Visitor.IsBlocked) { <span class="chip">@P["chat.blocked"]</span> }</span>
                    <span class="meta"><span class="ltr">@t.Visitor.Email</span><span>@P.Date(t.Visitor.LastMessageAtUtc ?? t.Visitor.CreatedAtUtc)</span></span>
                    @if (t.LastText is not null) { <span class="meta">@(t.LastText.Length > 90 ? t.LastText[..90] + "…" : t.LastText)</span> }
                </div>
                @if (t.Unread > 0) { <span class="badge">@t.Unread</span> }
            </a>
        }
    </div>
}
