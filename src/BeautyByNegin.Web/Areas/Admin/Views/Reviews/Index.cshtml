@model IReadOnlyList<Review>
@{
    var P = (PanelContext)ViewData["Panel"]!;
    ViewData["Title"] = P["nav.reviews"];
    ViewData["Nav"] = "reviews";
    var pending = ViewData["Pending"] is true;
    var pendingCount = (int)ViewData["PendingCount"]!;
    var lang = P.DefaultLanguage.Code;
}
<partial name="_PageIntro" model='("intro.reviews", $"/{lang}/reviews")' />
<partial name="_VisitorView" model='"reviews"' />
<div class="card-head">
    <div class="tabs-line">
        <a href="@P.Url("reviews")" class="@(!pending ? "is-active" : "")">@P["rev.published"]</a>
        <a href="@P.Url("reviews?tab=pending")" class="@(pending ? "is-active" : "")">@P["rev.pending"] @if (pendingCount > 0) { <span class="badge">@pendingCount</span> }</a>
    </div>
    <a class="btn btn-primary" href="@P.Url("reviews/create")"><svg class="i"><use href="#a-plus" /></svg>@P["rev.add"]</a>
</div>
@if (!P.Settings.AllowVisitorReviews && pending)
{
    <p class="hint-note">@P["rev.visitorOff"]</p>
}
@if (Model.Count == 0)
{
    <div class="card empty">
        @(pending ? P["rev.noPending"] : P["rev.empty"])
        @if (!pending) { <div><a class="btn btn-primary" href="@P.Url("reviews/create")">@P["rev.addFirst"]</a></div> }
    </div>
}
else
{
    @if (!pending) { <p class="help">@P["common.dragHelp"]</p> }
    <div class="list" data-sortable="@(pending ? null : P.Url("reviews/sort"))">
        @foreach (var r in Model)
        {
            <div class="item @(r.IsVisible ? "" : "is-hidden")" data-id="@r.Id" data-hide-when-off>
                @if (!pending) { <span class="drag-handle"><svg class="i"><use href="#a-drag" /></svg></span> }
                <div class="body">
                    <a class="title" href="@P.Url($"reviews/edit/{r.Id}")">@r.DisplayName @(r.Rating is int s ? new string('★', s) : "")</a>
                    <span class="meta"><span>@(r.Text.Length > 110 ? r.Text[..110] + "…" : r.Text)</span></span>
                    <span class="meta"><span>@r.LanguageCode.ToUpperInvariant()</span><span>@P["source." + r.Source.ToString().ToLowerInvariant()]</span>@if (r.ReviewDate is DateOnly d) { <span>@P.Day(d)</span> }</span>
                </div>
                <div class="actions">
                    @if (pending)
                    {
                        <button type="button" class="btn btn-sm btn-primary" data-post="@P.Url($"reviews/approve/{r.Id}")" data-remove=".item"><svg class="i"><use href="#a-check" /></svg>@P["rev.approve"]</button>
                    }
                    else
                    {
                        <label class="switch"><input type="checkbox" checked="@r.IsVisible" data-toggle-url="@P.Url($"reviews/toggle/{r.Id}")" /><span class="track"></span><span class="small">@P["common.visible"]</span></label>
                        <span class="move-btns"><button type="button" class="icon-btn" data-move="up"><svg class="i"><use href="#a-up" /></svg></button><button type="button" class="icon-btn" data-move="down"><svg class="i"><use href="#a-down" /></svg></button></span>
                    }
                    <a class="icon-btn" href="@P.Url($"reviews/edit/{r.Id}")"><svg class="i"><use href="#a-edit" /></svg></a>
                    <button type="button" class="icon-btn" data-post="@P.Url($"reviews/delete/{r.Id}")" data-confirm="@P["common.confirmTrash"]" data-remove=".item"><svg class="i"><use href="#a-trash" /></svg></button>
                </div>
            </div>
        }
    </div>
}
