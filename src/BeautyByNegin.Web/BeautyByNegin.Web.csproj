<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>BeautyByNegin.Web</RootNamespace>
    <!-- Persian/Turkish/German culture data and Jalali calendar need full ICU globalization -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <UserSecretsId>beauty-by-negin-web</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="NUglify" Version="1.23.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BeautyByNegin.Business\BeautyByNegin.Business.csproj" />
    <ProjectReference Include="..\BeautyByNegin.DataAccess\BeautyByNegin.DataAccess.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="BeautyByNegin.Business.Localization" />
  </ItemGroup>

  <!-- Runtime data lives in App_Data (database, logs, backups); never publish developer copies of it -->
  <ItemGroup>
    <Content Remove="App_Data\**" />
    <None Remove="App_Data\**" />
    <Content Remove="wwwroot\uploads\**" />
  </ItemGroup>

  <!-- The Persian panel guide (docs/panel-rehberi-fa.md) is shown under "Help" in the panel, so it ships with the app -->
  <ItemGroup>
    <None Include="..\..\docs\**\*.md" Link="docs\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
