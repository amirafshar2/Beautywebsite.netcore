@inject BeautyByNegin.Web.Infrastructure.AssetUrls Assets
@inject SiteContext Site
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    var ctx = await Site.GetAsync();
    var T = ctx.T;
    var title = ViewData["Title"] as string;
    var pageTitle = string.IsNullOrWhiteSpace(title) ? (T.Has("seo.home.title") ? T["seo.home.title"] : ctx.Settings.BrandName) : $"{title} · {ctx.Settings.BrandName}";
    if (ctx.Settings.Bool(BeautyByNegin.DataAccess.SettingKeys.AddCityToTitles) && !string.IsNullOrWhiteSpace(ctx.Settings.City) && !pageTitle.Contains(ctx.Settings.City))
        pageTitle += " · " + ctx.Settings.City;
    ViewData["FullTitle"] = pageTitle;
    var description = ViewData["Description"] as string ?? T["seo.home.description"];
}
<!DOCTYPE html>
<html lang="@ctx.Code" dir="@ctx.Lang.Dir" class="no-js">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>@pageTitle</title>
    <meta name="description" content="@description" />
    <meta name="theme-color" content="#F5F0E8" />
    @{ var googleCode = ctx.Settings.Get(BeautyByNegin.DataAccess.SettingKeys.GoogleVerification); }
    @if (!string.IsNullOrEmpty(googleCode)) { <meta name="google-site-verification" content="@googleCode" /> }
    <meta name="csrf-token" content="@Antiforgery.GetAndStoreTokens(Context).RequestToken" />
    <link rel="icon" href="@(ctx.Layout.FaviconUrl ?? "/favicon.ico")" />
    @if (ctx.Code is "fa" or "ar")
    {
        <link rel="preload" href="/fonts/Vazirmatn-Light.woff2" as="font" type="font/woff2" crossorigin />
    }
    else
    {
        <link rel="preload" href="/fonts/cormorant-garamond-latin-300-normal.woff2" as="font" type="font/woff2" crossorigin />
        <link rel="preload" href="/fonts/jost-latin-300-normal.woff2" as="font" type="font/woff2" crossorigin />
    }
    <link rel="stylesheet" href="@Assets.Url("/css/site.css")" />
    @{ var themeCss = BeautyByNegin.Business.Content.Theme.BuildCss(ctx.Settings); }
    @if (themeCss.Length > 0) { <link rel="stylesheet" href="/theme.css?v=@BeautyByNegin.Business.Content.Theme.Version(themeCss)" /> }
    @await Html.PartialAsync("_Seo", ctx)
    @await RenderSectionAsync("Head", required: false)
</head>
<body class="lang-@ctx.Code has-action-bar">
    <a class="skip-link" href="#main">@T["nav.skip"]</a>
    @await Html.PartialAsync("_Icons")
    @await Html.PartialAsync("_Header", ctx)

    <main id="main">
        @RenderBody()
    </main>

    @await Html.PartialAsync("_Footer", ctx)
    @await Html.PartialAsync("_ActionBar", ctx)
    @await Html.PartialAsync("_AskModal", ctx)
    @if (ctx.Settings.ChatAvailable)
    {
        @await Html.PartialAsync("_Chat", ctx)
        <script src="@Assets.Url("/js/chat.js")" defer></script>
    }

    <script src="@Assets.Url("/js/site.js")" defer></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
