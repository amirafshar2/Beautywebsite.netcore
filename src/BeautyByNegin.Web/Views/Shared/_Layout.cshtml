@inject SiteContext Site
@{
    var ctx = await Site.GetAsync();
    var T = ctx.T;
    var title = ViewData["Title"] as string;
    var pageTitle = string.IsNullOrWhiteSpace(title) ? (T.Has("seo.home.title") ? T["seo.home.title"] : ctx.Settings.BrandName) : $"{title} · {ctx.Settings.BrandName}";
    var description = ViewData["Description"] as string ?? T["seo.home.description"];
}
<!DOCTYPE html>
<html lang="@ctx.Code" dir="@ctx.Lang.Dir" class="no-js">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>@pageTitle</title>
    <meta name="description" content="@description" />
    <meta name="theme-color" content="#F5F0E8" />
    <link rel="icon" href="@(ctx.Layout.FaviconUrl ?? "/favicon.ico")" />
    @if (ctx.Code is "fa" or "ar")
    {
        <link rel="preload" href="/fonts/Vazirmatn-Light.woff2" as="font" type="font/woff2" crossorigin />
    }
    else
    {
        <link rel="preload" href="/fonts/cormorant-garamond-latin-300-normal.woff2" as="font" type="font/woff2" crossorigin />
        <link rel="preload" href="/fonts/jost-latin-300-normal.woff2" as="font" type="font/woff2" crossorigin />
    }
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @foreach (var (code, url) in ctx.Alternates)
    {
        <link rel="alternate" hreflang="@code" href="@url" />
    }
    @await RenderSectionAsync("Head", required: false)
</head>
<body class="lang-@ctx.Code has-action-bar">
    <a class="skip-link" href="#main">@T["nav.skip"]</a>
    @await Html.PartialAsync("_Icons")
    @await Html.PartialAsync("_Header", ctx)

    <main id="main">
        @RenderBody()
    </main>

    @await Html.PartialAsync("_Footer", ctx)
    @await Html.PartialAsync("_ActionBar", ctx)
    @await Html.PartialAsync("_AskModal", ctx)
    @if (ctx.Settings.ChatAvailable)
    {
        @await Html.PartialAsync("_Chat", ctx)
    }

    <script src="~/js/site.js" asp-append-version="true" defer></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
