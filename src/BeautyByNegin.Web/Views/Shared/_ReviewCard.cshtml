@model ReviewView
@inject SiteContext Site
@{
    var ctx = await Site.GetAsync();
    var rtl = Model.LanguageCode is "fa" or "ar";
}
<figure class="review-card" lang="@Model.LanguageCode" dir="@(rtl ? "rtl" : "ltr")">
    @if (Model.Rating is int stars and > 0)
    {
        <div class="stars" role="img" aria-label="@stars / 5">
            @for (var i = 1; i <= 5; i++)
            {
                <svg class="icon @(i <= stars ? "on" : "off")" aria-hidden="true"><use href="#i-star" /></svg>
            }
        </div>
    }
    <blockquote>@Model.Text</blockquote>
    <figcaption>
        <strong>@Model.Name</strong>
        @if (Model.ServiceName is not null)
        {
            <span class="muted"> · @Model.ServiceName</span>
        }
        @if (Model.Date is DateOnly d)
        {
            <time class="muted" datetime="@d.ToString("yyyy-MM-dd")">@DateDisplay.FormatDate(d.ToDateTime(TimeOnly.MinValue), ctx.Lang)</time>
        }
    </figcaption>
</figure>
