@inject SiteContext Site
@{
    var ctx = await Site.GetAsync();
    ViewData["Title"] = ctx.T["error.404.title"];
}
<section class="container error-page">
    <p class="code" aria-hidden="true">404</p>
    <h1>@ctx.T["error.404.title"]</h1>
    <p class="muted">@ctx.T["error.404.text"]</p>
    <a class="btn btn-primary" href="@SiteUrls.Home(ctx.Code)">@ctx.T["btn.backHome"]</a>
</section>
