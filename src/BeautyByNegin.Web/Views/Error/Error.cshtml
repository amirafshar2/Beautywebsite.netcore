@inject SiteContext Site
@{
    var ctx = await Site.GetAsync();
    ViewData["Title"] = ctx.T["error.500.title"];
}
<section class="container error-page">
    <h1>@ctx.T["error.500.title"]</h1>
    <div class="btn-row">
        <a class="btn btn-primary" href="@SiteUrls.Home(ctx.Code)">@ctx.T["btn.backHome"]</a>
        @if (ctx.Contact.PhoneUrl is not null)
        {
            <a class="btn" href="@ctx.Contact.PhoneUrl">@ctx.T["btn.call"]</a>
        }
    </div>
</section>
