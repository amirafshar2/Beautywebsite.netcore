@model IReadOnlyList<ServiceCard>
@inject SiteContext Site
@{
    var ctx = await Site.GetAsync();
    var T = ctx.T;
}
<section class="page-hero">
    <div class="container">
        <p class="eyebrow">@T["services.eyebrow"]</p>
        <h1>@T["services.title"]</h1>
        @Html.Paragraphs(T["services.intro"], "lead")
    </div>
</section>

<section class="section pt-0">
    <div class="container">
        @if (Model.Count == 0)
        {
            <p class="empty-state">@T["services.empty"]</p>
        }
        else
        {
            <div class="grid grid-3">
                @foreach (var s in Model)
                {
                    <partial name="_ServiceCard" model="s" />
                }
            </div>
            <p class="note">@T["services.note"]</p>
        }
    </div>
</section>

<partial name="_Consultation" />
