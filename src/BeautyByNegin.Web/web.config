<?xml version="1.0" encoding="utf-8"?>
<!-- IIS / Plesk settings. "dotnet publish" fills in the right processPath (also for self-contained publish). -->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="%LAUNCHER_PATH%" arguments="%LAUNCHER_ARGS%" stdoutLogEnabled="false" stdoutLogFile=".\App_Data\logs\stdout" hostingModel="inprocess" />
      <security>
        <requestFiltering>
          <!-- Backup zip upload (restore) can be large: allow up to 2 GB (IIS default is only 30 MB) -->
          <requestLimits maxAllowedContentLength="2147483648" />
        </requestFiltering>
      </security>
    </system.webServer>
  </location>
</configuration>
